<Window x:Class="OperatorUI.Views.LiveMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Equipment Dashboard"
        Height="820"
        Width="900"
        MinHeight="700"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>

            <!-- Machine state -->
            <RowDefinition Height="Auto"/>

            <!-- Equipment cards -->
            <RowDefinition Height="Auto"/>

            <!-- Event log -->
            <RowDefinition Height="*"/>

            <!-- Command buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- Header -->
        <!-- ================================================= -->

        <Border Grid.Row="0"
                Background="#1F2937"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock Text="Live Equipment Dashboard"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,14"/>

                    <TextBlock x:Name="MachineTypeText"
                               Text="CVD Chamber"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock x:Name="MachineIdText"
                               Text="EQ-001"
                               FontSize="17"
                               Foreground="#D1D5DB"
                               Margin="0,4,0,0"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="40,0,0,0">

                    <TextBlock Text="Simulation Time"
                               FontSize="15"
                               Foreground="#D1D5DB"
                               HorizontalAlignment="Right"/>

                    <TextBlock x:Name="SimulationTimeText"
                               Text="0.0 s"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0"/>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================= -->
        <!-- Machine state -->
        <!-- ================================================= -->

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="18"
                Margin="0,0,0,16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Machine State"
                           FontSize="16"
                           Foreground="#6B7280"
                           VerticalAlignment="Center"
                           Margin="0,0,30,0"/>

                <TextBlock x:Name="MachineStateText"
                           Grid.Column="1"
                           Text="OFFLINE"
                           FontSize="30"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

            </Grid>
        </Border>

        <!-- ================================================= -->
        <!-- Equipment status cards -->
        <!-- ================================================= -->

        <UniformGrid Grid.Row="2"
                     Columns="2"
                     Rows="2"
                     Margin="0,0,0,6">

            <!-- Pump -->
            <Border Background="White"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,8,8">

                <StackPanel>

                    <TextBlock Text="Pump Pressure"
                               FontSize="16"
                               Foreground="#6B7280"/>

                    <TextBlock x:Name="PumpPressureText"
                               Text="0.00 bar"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,8,0,10"/>

                    <ProgressBar x:Name="PumpPressureBar"
                                 Height="22"
                                 Minimum="0"
                                 Maximum="3.2"
                                 Value="0"/>

                    <TextBlock x:Name="PumpPercentText"
                               Text="0%"
                               FontSize="12"
                               Foreground="#6B7280"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0"/>

                    <TextBlock x:Name="PumpStatusText"
                               Text="Stopped"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"/>

                </StackPanel>
            </Border>

            <!-- Flow -->
            <Border Background="White"
                    CornerRadius="8"
                    Padding="20"
                    Margin="8,0,0,8">

                <StackPanel>

                    <TextBlock Text="Flow Rate"
                               FontSize="16"
                               Foreground="#6B7280"/>

                    <TextBlock x:Name="FlowRateText"
                               Text="0.00 sccm"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,8,0,5"/>

                </StackPanel>
            </Border>

            <!-- Temperature -->
            <Border Background="White"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,8,8,0">

                <StackPanel>

                    <TextBlock Text="Temperature"
                               FontSize="16"
                               Foreground="#6B7280"/>

                    <TextBlock x:Name="TemperatureText"
                               Text="25.00 °C"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,8,0,5"/>

                </StackPanel>
            </Border>

            <!-- Vacuum -->
            <Border Background="White"
                    CornerRadius="8"
                    Padding="20"
                    Margin="8,8,0,0">

                <StackPanel>

                    <TextBlock Text="Vacuum"
                               FontSize="16"
                               Foreground="#6B7280"/>

                    <TextBlock x:Name="VacuumText"
                               Text="0.0010 Torr"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,8,0,5"/>

                </StackPanel>
            </Border>

        </UniformGrid>

        <!-- ================================================= -->
        <!-- Event log -->
        <!-- ================================================= -->

        <GroupBox Grid.Row="3"
                  Header="Event Log"
                  Margin="0,16,0,16"
                  Padding="8"
                  FontSize="15"
                  FontWeight="SemiBold">

            <TextBox x:Name="EventLogText"
                     FontFamily="Consolas"
                     FontSize="13"
                     FontWeight="Normal"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     Background="#111827"
                     Foreground="#E5E7EB"
                     BorderThickness="0"
                     Padding="10"/>

        </GroupBox>

        <!-- ================================================= -->
        <!-- Commands -->
        <!-- ================================================= -->

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left">

            <Button Content="Initialize"
                    Width="120"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="InitializeButton_Click"/>

            <Button Content="Start Machine"
                    Width="130"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="StartMachineButton_Click"/>

            <Button Content="Start Pump"
                    Width="120"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="StartPumpButton_Click"/>

            <Button Content="Stop Monitor"
                    Width="120"
                    Height="40"
                    Click="StopButton_Click"/>

        </StackPanel>

    </Grid>
</Window>
<Window x:Class="OperatorUI.Views.LiveMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Equipment Dashboard"
        Height="620"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Live Equipment Dashboard"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="#1F2937"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="18"
                Margin="0,0,0,18">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Machine"
                               Foreground="#6B7280"
                               FontSize="14"/>

                    <TextBlock x:Name="MachineIdText"
                               Text="EQ-001"
                               FontSize="22"
                               FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="State"
                               Foreground="#6B7280"
                               FontSize="14"/>

                    <TextBlock x:Name="MachineStateText"
                               Text="Offline"
                               FontSize="22"
                               FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Simulation Time"
                               Foreground="#6B7280"
                               FontSize="14"/>

                    <TextBlock x:Name="SimulationTimeText"
                               Text="0.0 s"
                               FontSize="22"
                               FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2"
                     Columns="2"
                     Rows="2">

            <Border Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,0,10,10">

                <StackPanel>
                    <TextBlock Text="Pump Pressure"
                               Foreground="#6B7280"
                               FontSize="15"/>

                    <TextBlock x:Name="PumpPressureText"
                               Text="0.00 bar"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,8,0,5"/>

                    <TextBlock x:Name="PumpStatusText"
                               Text="Stopped"
                               FontSize="16"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="10,0,0,10">

                <StackPanel>
                    <TextBlock Text="Flow Rate"
                               Foreground="#6B7280"
                               FontSize="15"/>

                    <TextBlock x:Name="FlowRateText"
                               Text="0.00 sccm"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,8,0,5"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,10,10,0">

                <StackPanel>
                    <TextBlock Text="Temperature"
                               Foreground="#6B7280"
                               FontSize="15"/>

                    <TextBlock x:Name="TemperatureText"
                               Text="25.00 °C"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,8,0,5"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="10,10,0,0">

                <StackPanel>
                    <TextBlock Text="Vacuum"
                               Foreground="#6B7280"
                               FontSize="15"/>

                    <TextBlock x:Name="VacuumText"
                               Text="0.001 Torr"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,8,0,5"/>
                </StackPanel>
            </Border>

        </UniformGrid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Margin="0,20,0,0">

            <Button Content="Initialize"
                    Width="120"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="InitializeButton_Click"/>

            <Button Content="Start Machine"
                    Width="130"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="StartMachineButton_Click"/>

            <Button Content="Start Pump"
                    Width="120"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="StartPumpButton_Click"/>

            <Button Content="Stop Monitor"
                    Width="120"
                    Height="40"
                    Click="StopButton_Click"/>

        </StackPanel>

    </Grid>
</Window>
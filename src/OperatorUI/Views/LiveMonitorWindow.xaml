<Window x:Class="OperatorUI.Views.LiveMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Equipment Monitor"
        Height="450"
        Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- Simulation Time -->
            <RowDefinition Height="Auto"/>
            <!-- Pump Pressure -->
            <RowDefinition Height="Auto"/>
            <!-- Pump Status -->
            <RowDefinition Height="*"/>
            <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- Title -->
        <!-- ================================================= -->

        <TextBlock Text="Live Equipment Monitor"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,24"/>

        <!-- ================================================= -->
        <!-- Simulation Time -->
        <!-- ================================================= -->

        <Grid Grid.Row="1"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Simulation Time"
                       FontSize="18"/>

            <TextBlock x:Name="SimulationTimeText"
                       Grid.Column="1"
                       FontSize="18"
                       FontWeight="Bold"
                       Text="0.0 s"/>
        </Grid>

        <!-- ================================================= -->
        <!-- Pump Pressure -->
        <!-- ================================================= -->

        <Grid Grid.Row="2"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Pump Pressure"
                       FontSize="18"/>

            <TextBlock x:Name="PumpPressureText"
                       Grid.Column="1"
                       FontSize="18"
                       FontWeight="Bold"
                       Text="0.00 bar"/>
        </Grid>

        <!-- ================================================= -->
        <!-- Pump Status -->
        <!-- ================================================= -->

        <Grid Grid.Row="3"
              Margin="0,0,0,30">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Pump Status"
                       FontSize="18"/>

            <TextBlock x:Name="PumpStatusText"
                       Grid.Column="1"
                       FontSize="18"
                       FontWeight="Bold"
                       Text="Stopped"/>
        </Grid>

        <!-- ================================================= -->
        <!-- Buttons -->
        <!-- ================================================= -->

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    VerticalAlignment="Top">

            <Button Content="Start Pump"
                    Width="120"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="StartPumpButton_Click"/>

            <Button Content="Stop Monitor"
                    Width="120"
                    Height="36"
                    Click="StopButton_Click"/>

        </StackPanel>
    </Grid>
</Window>
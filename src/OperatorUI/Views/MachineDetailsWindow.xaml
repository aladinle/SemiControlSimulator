<Window x:Class="OperatorUI.Views.MachineDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OperatorUI.Views"
        mc:Ignorable="d"
        Title="MachineDetailsWindow" Height="600" Width="900">
    <Grid Margin="20">
        <StackPanel>

            <TextBlock x:Name="TitleText"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock x:Name="MachineInfoText"
                       FontSize="16"
                       Margin="0,0,0,20"/>

            <GroupBox Header="Subsystems" Margin="0,0,0,20">
                <UniformGrid Columns="2" Margin="10">
                    <CheckBox Content="Robot Controller" IsChecked="True" IsEnabled="False"/>
                    <CheckBox Content="Motion Controller" IsChecked="True" IsEnabled="False"/>
                    <CheckBox Content="Pump Controller" IsChecked="True" IsEnabled="False"/>
                    <CheckBox Content="Flow Controller" IsChecked="True" IsEnabled="False"/>
                    <CheckBox Content="Temperature Sensor" IsChecked="True" IsEnabled="False"/>
                    <CheckBox Content="Pressure Sensor" IsChecked="True" IsEnabled="False"/>
                    <CheckBox Content="Alarm Manager" IsChecked="True" IsEnabled="False"/>
                    <CheckBox Content="Test Manager" IsChecked="True" IsEnabled="False"/>
                </UniformGrid>
            </GroupBox>

            <StackPanel Orientation="Horizontal">
                <Button Content="Open Test Setup"
                        Width="150"
                        Height="35"
                        Margin="0,0,10,0"/>

                <Button Content="Manual Control"
                        Width="150"
                        Height="35"
                        Margin="0,0,10,0"/>

                <Button Content="View Logs"
                        Width="120"
                        Height="35"
                        Margin="0,0,10,0"/>

                <Button Content="Back"
                        Width="100"
                        Height="35"
                        Click="BackButton_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>

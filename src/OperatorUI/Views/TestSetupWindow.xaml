<Window x:Class="OperatorUI.Views.TestSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OperatorUI.Views"
        mc:Ignorable="d"
        Title="Test Setup" Height="800" Width="900"
        WindowStartupLocation="CenterScreen">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock x:Name="TitleText"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock x:Name="MachineInfoText"
                       FontSize="16"
                       Margin="0,0,0,20"/>

            <GroupBox Header="Select Test Modules" Margin="0,0,0,15">
                <UniformGrid Columns="2" Margin="10">
                    <CheckBox Content="Robot Controller" IsChecked="True"/>
                    <CheckBox Content="Motion Controller" IsChecked="True"/>
                    <CheckBox Content="Pump Controller" IsChecked="True"/>
                    <CheckBox Content="Flow Controller" IsChecked="True"/>
                    <CheckBox Content="Temperature Sensor"/>
                    <CheckBox Content="Pressure Sensor"/>
                    <CheckBox Content="CAN Communication"/>
                    <CheckBox Content="Alarm System"/>
                </UniformGrid>
            </GroupBox>

            <GroupBox Header="Test Mode" Margin="0,0,0,15">
                <StackPanel Margin="10">
                    <RadioButton Content="Functional Test" IsChecked="True"/>
                    <RadioButton Content="Regression Test"/>
                    <RadioButton Content="Performance Test"/>
                    <RadioButton Content="Stress Test"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Parameters" Margin="0,0,0,15">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Motor Speed (RPM)" Grid.Row="0" Grid.Column="0"/>
                    <TextBox Text="3000" Grid.Row="0" Grid.Column="1"/>

                    <TextBlock Text="Flow Rate (sccm)" Grid.Row="1" Grid.Column="0"/>
                    <TextBox Text="15.0" Grid.Row="1" Grid.Column="1"/>

                    <TextBlock Text="Pressure (bar)" Grid.Row="2" Grid.Column="0"/>
                    <TextBox Text="3.2" Grid.Row="2" Grid.Column="1"/>

                    <TextBlock Text="Duration (seconds)" Grid.Row="3" Grid.Column="0"/>
                    <TextBox Text="60" Grid.Row="3" Grid.Column="1"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Fault Injection" Margin="0,0,0,20">
                <UniformGrid Columns="2" Margin="10">
                    <CheckBox Content="Motor Stall"/>
                    <CheckBox Content="Sensor Timeout"/>
                    <CheckBox Content="Pump Failure"/>
                    <CheckBox Content="Lost CAN Frame"/>
                </UniformGrid>
            </GroupBox>

            <StackPanel Orientation="Horizontal">
                <Button Content="Save Test"
                        Width="120"
                        Height="35"
                        Margin="0,0,10,0"/>

                <Button Content="Run Test"
                        Width="120"
                        Height="35"
                        Margin="0,0,10,0"/>

                <Button Content="Cancel"
                        Width="120"
                        Height="35"
                        Click="CancelButton_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
    
</Window>

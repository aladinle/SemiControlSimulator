<Window x:Class="OperatorUI.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OperatorUI"
        mc:Ignorable="d"
        Title="DashboardWindow" Height="500" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="SemiControl Simulator Dashboard"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock x:Name="UserInfoText"
                       FontSize="16"
                       Margin="0,0,0,20"/>

            <DataGrid x:Name="MachineGrid"
                  AutoGenerateColumns="False"
                  Height="250"
                  Margin="0,0,0,20"
                  SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Index" Binding="{Binding Index}" Width="80"/>
                    <DataGridTextColumn Header="Machine ID" Binding="{Binding MachineId}" Width="150"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding MachineType}" Width="200"/>
                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal">
                <Button Content="Open" Width="100" Height="35" Margin="0,0,10,0" Click="OpenDetailsButton_Click"/>
                <Button Content="Live Monitor" Width="140" Height="38" Margin="0,0,10,0" Click="LiveMonitorButton_Click"/>
                <Button Content="Start" Width="100" Height="35" Margin="0,0,10,0"/>
                <Button Content="Stop" Width="100" Height="35" Margin="0,0,10,0"/>
                <Button Content="Refresh" Width="100" Height="35"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>

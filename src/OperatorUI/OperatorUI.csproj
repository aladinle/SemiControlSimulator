<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Assets\" />
    <Folder Include="Resources\" />
    <Folder Include="ViewModels\" />
  </ItemGroup>

  <Target Name="BuildControlEngineDll" BeforeTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\ControlEngine\ControlEngine.vcxproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=x64" />
  </Target>

  <Target Name="CopyControlEngineDll" AfterTargets="Build">
    <PropertyGroup>
      <ControlEngineDll Condition="'$(Configuration)' == 'Release'">$(MSBuildThisFileDirectory)..\..\x64\Release\ControlEngine.dll</ControlEngineDll>
      <ControlEngineDll Condition="'$(Configuration)' != 'Release'">$(MSBuildThisFileDirectory)..\..\x64\Debug\ControlEngine.dll</ControlEngineDll>
    </PropertyGroup>

    <Error Condition="!Exists('$(ControlEngineDll)')"
           Text="ControlEngine.dll was not found at $(ControlEngineDll). Build the ControlEngine project first." />

    <Copy SourceFiles="$(ControlEngineDll)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="false"
          Condition="Exists('$(ControlEngineDll)')" />
  </Target>

</Project>
